<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Macro Recorder"
            app:titleTextColor="@color/text_primary"
            app:navigationIcon="@null"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Accessibility Warning Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_accessibility_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/warning_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/warning_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠ Accessibility Service Not Enabled"
                        android:textColor="@color/warning_text"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Required to record and replay actions system-wide."
                        android:textColor="@color/warning_text"
                        android:textSize="12sp"/>

                    <Button
                        android:id="@+id/btn_enable_accessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Enable Now"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:textColor="@color/warning_text"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Overlay Warning Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_overlay_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/info_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/info_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ℹ Floating Controls Not Enabled"
                        android:textColor="@color/info_text"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Optional: Allow overlay to show Record/Stop controls over any app."
                        android:textColor="@color/info_text"
                        android:textSize="12sp"/>

                    <Button
                        android:id="@+id/btn_enable_overlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Enable Overlay"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:textColor="@color/info_text"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/status_idle"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ready to record"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_action_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Record Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_record"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="8dp"
                android:text="⏺ Start Recording"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_red"
                app:cornerRadius="16dp"
                app:rippleColor="@color/accent_red_dark"/>

            <!-- Stop Playback Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stop_playback"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:text="⏹ Stop Playback"
                android:textSize="16sp"
                android:visibility="gone"
                app:backgroundTint="@color/accent_orange"
                app:cornerRadius="12dp"/>

            <!-- Floating Controls Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_floating_controls"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:text="🎯 Start Floating Controls"
                android:textSize="15sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="@color/accent_purple"
                android:textColor="@color/accent_purple"
                app:cornerRadius="12dp"/>

            <!-- Saved Macros Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Saved Macros"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/tv_empty_state"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎬"
                    android:textSize="48sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No macros yet"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap 'Start Recording' to create your first macro"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Macros RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_macros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
